{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/migrate-database.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:rbac": "node --import tsx scripts/test-rbac.ts",
    "test:audit": "node --import tsx scripts/test-audit-policy.ts",
    "test:developer-tools": "node --import tsx scripts/test-developer-tools.ts",
    "test:login-activity": "node --import tsx scripts/test-login-activity.ts",
    "db:migrate": "node --import tsx scripts/migrate-database.ts",
    "migration:export": "node --import tsx scripts/export-firebase.ts",
    "migration:import": "node --import tsx scripts/import-postgres.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "test:migration-import": "node --import tsx scripts/test-migration-import.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "firebase-admin": "^13.10.0"
  }
}
