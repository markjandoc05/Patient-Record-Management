{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "NODE_ENV=production vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/migrate-database.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:rbac": "node --import tsx scripts/test-rbac.ts",
    "test:audit": "node --import tsx scripts/test-audit-policy.ts",
    "test:developer-tools": "node --import tsx scripts/test-developer-tools.ts",
    "test:login-activity": "node --import tsx scripts/test-login-activity.ts",
    "db:migrate": "node --import tsx scripts/migrate-database.ts",
    "migration:export": "node --import tsx scripts/export-firebase.ts",
    "migration:import": "node --import tsx scripts/import-postgres.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "test:appointment-read-auth": "node --import tsx scripts/test-appointment-read-auth.ts",
    "test:migration-import": "node --import tsx scripts/test-migration-import.ts",
    "dev:setup": "node scripts/setup-local-development.mjs",
    "dev:db:up": "docker compose -f compose.development.yaml up -d --wait",
    "dev:db:stop": "docker compose -f compose.development.yaml stop",
    "dev:db:restart": "docker compose -f compose.development.yaml restart postgres",
    "dev:db:status": "docker compose -f compose.development.yaml ps",
    "dev:fixtures": "node --import tsx scripts/seed-local-development.ts",
    "dev:db:tunnel": "DOTENV_CONFIG_PATH=.env.tunnel node scripts/dev-tunnel.mjs",
    "dev:db:seed": "node --import tsx scripts/seed-development.ts",
    "dev:access:prepare": "node --import tsx scripts/prepare-support-development.ts",
    "test:support-access": "node --import tsx scripts/test-support-access.ts",
    "test:support-ui": "node --import tsx scripts/test-support-ui.ts",
    "test:support-subscriptions": "node --import tsx scripts/test-support-subscriptions.ts",
    "dev:access:verify": "node --import tsx scripts/verify-support-development.ts",
    "dev:accounts:configure": "node --import tsx scripts/configure-development-accounts.ts",
    "test:development-activation": "node --import tsx scripts/test-development-account-activation.ts",
    "dev:media:configure": "node --import tsx scripts/configure-development-media.ts",
    "test:shared-data": "node --import tsx scripts/test-shared-data-regression.ts",
    "test:workspace-overview": "node --import tsx scripts/test-workspace-overview.ts",
    "test:patient-lookup": "node --import tsx scripts/test-patient-lookup.ts",
    "test:patient-lookup-api": "node --import tsx scripts/test-patient-lookup-api.ts",
    "test:parity-regression": "node --import tsx scripts/test-parity-regression.ts",
    "test:user-onboarding": "node --import tsx scripts/test-user-onboarding.ts",
    "test:user-onboarding-ui": "node --import tsx scripts/test-user-onboarding-ui.ts",
    "test:patient-birth": "node --import tsx scripts/test-patient-birth.ts",
    "test:patient-registration-api": "node --import tsx scripts/test-patient-registration-api.ts",
    "test:patient-duplicates": "node --import tsx scripts/test-patient-duplicates.ts",
    "test:clinical-findings": "node --import tsx scripts/test-clinical-findings.ts",
    "test:clinical-findings-api": "node --import tsx scripts/test-clinical-findings-api.ts",
    "test:simple-registration": "node --import tsx scripts/test-simple-registration.ts",
    "test:simple-registration-api": "node --import tsx scripts/test-simple-registration-api.ts",
    "test:permissions": "node --import tsx scripts/test-permission-policy.ts",
    "test:permissions-api": "node --import tsx scripts/test-permission-api.ts",
    "test:permissions-repairs": "node --import tsx scripts/test-permission-repair-policy.ts",
    "test:permissions-scope": "node --import tsx scripts/test-permission-scope.ts",
    "test:services": "node --import tsx scripts/test-services-policy.ts",
    "test:services-api": "node --import tsx scripts/test-services-api.ts",
    "test:protected-invalidation": "tsx scripts/test-protected-invalidation.ts",
    "test:support-role-selector": "tsx scripts/test-support-role-selector.ts",
    "test:services-migration": "node --import tsx scripts/test-services-migration.ts",
    "test:visit-services-api": "tsx scripts/test-visit-services-api.ts",
    "test:visit-services-ui": "tsx scripts/test-visit-services-ui.ts",
    "test:appointment-services-api": "node --import tsx scripts/test-appointment-services-api.ts",
    "test:appointment-services-ui": "node --import tsx scripts/test-appointment-services-ui.ts",
    "test:services-ui": "node --import tsx scripts/test-services-ui.ts"
