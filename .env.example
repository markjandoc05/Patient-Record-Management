# Local development. Configure real secrets in Dokploy, never in source control.
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://vine:CHANGE_ME@localhost:5432/vine
STORAGE_DIR=./data/files
# Google OAuth web application. Production callback:
# https://app.vineaesthetics.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used by compose.yaml. Use a URL-safe randomly generated password.
POSTGRES_PASSWORD=
