# Local development. Prefer `npm run dev:setup` to generate the ignored .env.
# Placeholder values only; never commit real credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Local PostgreSQL 17 (compose.development.yaml). `npm run dev:setup` generates
# both values. DATABASE_URL encodes 127.0.0.1:55439, vine_development and vine_dev.
LOCAL_POSTGRES_PASSWORD=
DATABASE_URL=

# Dedicated development Google OAuth web application. Local callback:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private local files, separate from production persistent storage.
STORAGE_DIR=./data/local-development-files

# Production uses its own values for APP_URL, PORT, NODE_ENV, DATABASE_URL,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and STORAGE_DIR. The separate production
# compose.yaml template additionally uses POSTGRES_PASSWORD; do not run it locally.
