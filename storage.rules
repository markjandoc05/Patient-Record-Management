rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Branding is intentionally public because it appears before sign-in.
    // Writes go through the authenticated server endpoint so roles can be
    // checked against Vine's named Firestore database.
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Clinical attachments are never served directly by Storage. The server
    // validates the active profile, role, patient, parent resource, and write
    // branch before streaming, uploading, or deleting an object.
    match /uploads/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
