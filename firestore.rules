rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveProfile() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }

    function getUserRole(uid) {
      return get(userPath(uid)).data.role;
    }

    function hasAnyRole(roles) {
      return hasActiveProfile() && getUserRole(request.auth.uid) in roles;
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isSupportDeveloper() {
      return hasAnyRole(['support_developer']);
    }

    function isSafePendingProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'email',
          'fullName',
          'role',
          'active',
          'assignedBranches',
          'assignedBranchNames',
          'defaultBranchId',
          'defaultBranchName'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'fullName',
          'role',
          'active',
          'assignedBranches',
          'assignedBranchNames',
          'defaultBranchId',
          'defaultBranchName'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.role == 'staff'
        && request.resource.data.active == false
        && request.resource.data.assignedBranches == []
        && request.resource.data.assignedBranchNames == []
        && request.resource.data.defaultBranchId == null
        && request.resource.data.defaultBranchName == null;
    }

    function isSafeSelfProfileUpdate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'birthdate',
          'contactNumber',
          'lastUpdatedBy',
          'lastUpdatedDate'
        ])
        && request.resource.data.lastUpdatedBy == request.auth.uid;
    }

    function isAdminUserUpdate(userId) {
      return isAdmin()
        && resource.data.role != 'support_developer'
        && request.resource.data.role != 'support_developer'
        && (
          request.auth.uid != userId
          || (
            request.resource.data.role == resource.data.role
            && request.resource.data.active == true
          )
        );
    }

    match /users/{userId} {
      // Pending users may only see their own profile. Approved users need the
      // directory for doctor assignment and display names.
      allow read: if isSignedIn() && (
        request.auth.uid == userId || hasActiveProfile()
      );

      // Public registration always creates a disabled Staff profile. Privileged
      // roles must be assigned through trusted Admin SDK code or by an approved
      // administrator after registration.
      allow create: if isSafePendingProfile(userId);

      // Self-service writes are restricted to personal profile fields. Role,
      // approval state, and branch access cannot be changed by the account owner.
      allow update: if isSafeSelfProfileUpdate(userId)
        || isAdminUserUpdate(userId)
        || isSupportDeveloper();

      allow delete: if isAdmin()
        && resource.data.role != 'support_developer'
        && request.auth.uid != userId;
    }

    match /appointments/{appointmentId} {
      // Authorized clinic users share the patient's longitudinal schedule.
      // Branch assignment controls trusted server writes, not continuity reads.
      allow read: if hasAnyRole(['admin', 'manager', 'staff', 'doctor', 'support_developer']);
      // Record mutations are validated and audited by the trusted server API.
      allow create, update, delete: if false;
    }

    match /visits/{visitId} {
      allow read: if hasAnyRole(['admin', 'manager', 'staff', 'doctor', 'support_developer']);
      // Record mutations are validated and audited by the trusted server API.
      allow create, update, delete: if false;
    }

    match /patients/{patientId} {
      // There is one shared patient identity across all clinic branches.
      allow read: if hasAnyRole(['admin', 'manager', 'staff', 'doctor', 'support_developer']);
      // Record mutations are validated and audited by the trusted server API.
      allow create, update, delete: if false;

      match /privateNotes/{noteId} {
        allow read: if hasAnyRole(['admin', 'doctor', 'support_developer']);
        allow create: if hasAnyRole(['admin', 'doctor', 'support_developer'])
          && request.resource.data.patientId == patientId
          && request.resource.data.authorId == request.auth.uid;
        allow update: if hasAnyRole(['admin', 'support_developer'])
          || (
            hasAnyRole(['doctor'])
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.patientId == resource.data.patientId
          );
        allow delete: if hasAnyRole(['admin', 'support_developer']);
      }
    }

    match /branches/{branchId} {
      allow read: if hasActiveProfile();
      allow write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /settings/branding {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /settings/timezone {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /settings/footer {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /settings/media {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'support_developer']);
    }

    // New settings documents are denied until an explicit permission policy is
    // added above. This prevents accidental public configuration writes.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /audit_logs/{logId} {
      // Managers regain branch-scoped audit access after audit records carry a
      // trusted branchId. Until then, global audit visibility is admin-only.
      allow read: if hasAnyRole(['admin', 'support_developer']);
      // Audit records are written only by trusted Admin SDK server operations.
      // Clients cannot forge actors, timestamps, roles, or event details.
      allow create, update, delete: if false;
    }

    match /inventory_items/{itemId} {
      allow read, write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /inventory_stocks/{stockId} {
      allow read, write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /suppliers/{supplierId} {
      allow read, write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /stock_transfers/{transferId} {
      allow read, write: if hasAnyRole(['admin', 'support_developer']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
